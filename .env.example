# Tên miền trỏ về máy chủ (bản ghi A/AAAA). Caddy tự xin chứng chỉ HTTPS.
DOMAIN=pkm.example.com
# Email nhận thông báo từ Let's Encrypt (không bắt buộc)
ACME_EMAIL=
# Để trống = ai có link cũng đăng ký được. Đặt giá trị = bạn bè phải nhập mã này khi tạo tài khoản.
INVITE_CODE=
# Nhánh/tag của pokeemerald-expansion để build ROM
ROM_REF=master
# Số giây tối đa cho mỗi lượt PVP; quá giờ bị xử thua (AFK)
BATTLE_TURN_SECONDS=60
ROM_REPO=https://github.com/rh-hideout/pokeemerald-expansion.git
